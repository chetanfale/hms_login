		{
			"name": "Forgot Password",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"if (jsonData && jsonData.success && jsonData.data && jsonData.data.reset_token) {",
							"    pm.collectionVariables.set('reset_token', jsonData.data.reset_token);",
							"    pm.environment.set('reset_token', jsonData.data.reset_token);",
							"    pm.globals.set('reset_token', jsonData.data.reset_token);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
